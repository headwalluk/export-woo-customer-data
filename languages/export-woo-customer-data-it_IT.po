#. Plugin Name of the plugin
#: export-woo-customer-data.php
msgid "Export Woo Customer Data"
msgstr "Export Woo Customer Data"

#. Plugin URI of the plugin
#: export-woo-customer-data.php
msgid "https://headwall-hosting.com/plugins/export-woo-customer-data/"
msgstr "https://headwall-hosting.com/plugins/export-woo-customer-data/"

#. Description of the plugin
#: export-woo-customer-data.php
msgid "Download your users or WooCommerce customers as a CSV file from a Dashboard widget, with names, email addresses and phone numbers."
msgstr "Scarica i dati dei tuoi utenti o dei clienti WooCommerce in un file CSV da un widget della Dashboard, con nomi, indirizzi e-mail e numeri di telefono."

#. Author of the plugin
#: export-woo-customer-data.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: export-woo-customer-data.php
msgid "https://headwall-hosting.com/a-web-guys-blog/"
msgstr "https://headwall-hosting.com/a-web-guys-blog/"

#: includes/class-csv-exporter.php:44
msgid "No customers have placed an order yet, so there is nothing to export."
msgstr "Nessun cliente ha ancora effettuato un ordine, quindi non c'è nulla da esportare."

#: includes/class-csv-exporter.php:45
msgid "Nothing to export"
msgstr "Niente da esportare"

#: includes/class-csv-exporter.php:51
msgid "The export could not be started. The server log has the details."
msgstr "Non è stato possibile avviare l'esportazione. I dettagli sono riportati nel log del server."

#: includes/class-csv-exporter.php:52
msgid "Export failed"
msgstr "Esportazione non riuscita"

#: functions-private.php:36
#: includes/class-plugin.php:116
msgid "Export Customer Data"
msgstr "Esporta i dati dei clienti"

#: includes/class-plugin.php:95
msgid "You do not have permission to export customer data."
msgstr "Non disponi dell'autorizzazione necessaria per esportare i dati dei clienti."

#: includes/class-plugin.php:109
msgid "That report is not available on this site."
msgstr "Quel rapporto non è disponibile su questo sito."

#: views/dashboard-widget.php:23
msgid "Download customer data as a CSV file."
msgstr "Scarica i dati dei clienti in un file CSV."

#. translators: %s is the Dashboard widget's title, Export Customer Data
#: includes/class-plugin.php:100
#, php-format
msgid "This download link has expired. Go back to the Dashboard and use the button in the %s widget."
msgstr "Questo link per il download è scaduto. Torna alla Dashboard e utilizza il pulsante presente nel widget %s."

#: views/dashboard-widget.php:28
msgctxt "button label: download a CSV of every user account"
msgid "Export All Users"
msgstr "Esporta tutti gli utenti"

#: views/dashboard-widget.php:35
msgctxt "button label: download a CSV of only the users who have placed an order"
msgid "Export Customers Only"
msgstr "Esporta solo i clienti"

#: views/dashboard-widget.php:38
msgid "Exporting only customers needs WooCommerce, which is not active on this site."
msgstr "Per esportare solo i clienti è necessario WooCommerce, che non è attivo su questo sito."
